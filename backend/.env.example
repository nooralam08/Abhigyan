# ==============================================================================
# Abhigyan Environment Configuration Template
# Copy this file to `backend/.env` or `.env` in the project root.
# ==============================================================================

# Supabase PostgreSQL connection URL (copy the Session pooler URL from Supabase > Connect).
# Replace the placeholders; URL-encode reserved characters in the database password.
# SQLAlchemy enables SSL automatically if sslmode is omitted.
DATABASE_URL=postgresql://postgres.PROJECT-REF:YOUR-PASSWORD@YOUR-POOLER-HOST:5432/postgres?sslmode=require

# Allowed CORS Origins (comma-separated, Vite dev and preview servers)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://abhigyann.vercel.app

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Base API path prefix
API_PREFIX=/api

# JWT Authentication Configuration
# In production, replace with a secure, randomly generated 32+ character key
JWT_SECRET_KEY=abhigyan-development-insecure-secret-key-change-in-prod-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Development Demo Authentication (Must be False in production)
DEMO_AUTH_ENABLED=True
DEFAULT_SEED_PASSWORD=AicteDemo@2026

# AI Advisory Classifier Configuration
# Minimum confidence threshold (0.0 - 1.0) before flagging for manual human review
AI_CONFIDENCE_THRESHOLD=0.40
